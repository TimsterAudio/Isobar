{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isobar",
  "version": "0.1.0",
  "identifier": "app.isobar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Isobar",
        "width": 1380,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "category": "Weather",
    "shortDescription": "Desktop companion for Cumulus MX weather stations",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
